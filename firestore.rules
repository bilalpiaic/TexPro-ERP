rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.memberUids;
    }

    // User profile: only the authenticated user can access their own document
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Organization tenant document
    match /organizations/{orgId} {
      allow get: if isSignedIn() && (request.auth.uid in resource.data.memberUids);
      allow list: if isSignedIn() && (request.auth.uid in resource.data.memberUids);
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.auth.uid in request.resource.data.memberUids;
      allow update: if isSignedIn() &&
        (request.auth.uid in resource.data.memberUids) &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Subcollections within tenant organization
      match /members/{memberId} {
        allow read, write: if isSignedIn() &&
          (isOrgMember(orgId) || request.auth.uid == memberId);
      }

      match /accounts/{accountId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /vouchers/{voucherId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /lots/{lotId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /sale_orders/{orderId} {
        allow read, write: if isOrgMember(orgId);
      }
    }
  }
}
